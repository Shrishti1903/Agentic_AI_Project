# Copy this file to .env and fill in your key.
# The .env file is gitignored and will never be committed.
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Required if your API key is org-level (not workspace-scoped).
# Find it at: console.anthropic.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=wrkspc_...your-workspace-id-here...
